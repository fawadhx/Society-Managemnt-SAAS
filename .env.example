NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: required for the Super Admin console to provision clients & users.
# Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 to resolve Tier-3 clients from their subdomain (acme.example.com → /acme)
NEXT_PUBLIC_MULTI_DOMAIN=

# Self-hosted Postgres (migration off Supabase, in progress — see MIGRATION-NOTES.md).
# Matches docker-compose.yml's default db/user/password.
DATABASE_URL=postgres://society_manager:society_manager@localhost:5432/society_manager
